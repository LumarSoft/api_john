          "format": "int32",
          "description": "Condición fiscal",
          "enum": [
            "1 Responsable Inscripto",
            "2 Responsable No Inscripto",
            "3 Exento",
            "4 Consumidor Final",
            "5 No Declarado",
            "6 No Alcanzado",
            "7 Responsable Monotributo"
