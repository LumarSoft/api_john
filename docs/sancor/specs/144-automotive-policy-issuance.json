{
  "swagger": "2.0",
  "info": {
    "title": "Emisión Automotores",
    "version": "1.0.0",
    "description": "Servicio para emitir pólizas del ramo Automotores.",
    "x-ibm-name": "automotive-policy-issuance",
    "x-ibm-summary": ""
  },
  "paths": {
    "/issuance/single": {
      "post": {
        "operationId": "postSinglePolicy",
        "responses": {
          "200": {
            "description": "Success",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "201": {
            "description": "Created",
            "schema": {
              "$ref": "#/definitions/singlePolicyResponse"
            }
          },
          "400": {
            "description": "Invalid or misspelled input parameter error.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "401": {
            "description": "Authentication.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "403": {
            "description": "Authorization.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "415": {
            "description": "Mandatory parameters missing.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "422": {
            "description": "Wrong/Invalid parameter(s).",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "500": {
            "description": "No response from Backend.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          },
          "504": {
            "description": "TimeOut from server.",
            "schema": {
              "$ref": "#/definitions/Message"
            }
          }
        },
        "consumes": [
          "application/json"
        ],
        "produces": [
          "application/json"
        ],
        "description": "Operación para crear una póliza de auto/moto.",
        "parameters": [
          {
            "name": "body",
            "in": "body",
            "schema": {
              "$ref": "#/definitions/singlePolicyRequest"
            },
            "description": "body",
            "required": true
          },
          {
            "name": "Authorization",
            "in": "header",
            "type": "string",
            "required": true
          }
        ]
      }
    }
  },
  "basePath": "/apissa/pre-catalog/vehicle/automotive",
