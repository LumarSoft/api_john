            "properties": {
              "errorMessage": {
                "type": "string"
              }
            }
          }
        },
        "managementNumber": {
          "type": "string"
        },
        "managementStatusName": {
          "type": "string"
        },
        "officialNumber": {
          "type": "integer"
        },
        "receipt": {
          "type": "object",
          "properties": {
            "detail": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "receiptDescription": {
                    "type": "string"
                  },
                  "issueTransactionPremium": {
                    "type": "integer",
                    "format": "decimal"
                  },
                  "quotaAmount": {
                    "type": "integer",
                    "format": "decimal"
                  }
                }
              }
            },
            "receiptNumber": {
              "type": "integer"
            }
          }
        },
        "referenceNumber": {
          "type": "integer"
        }
      }
    },
    "singlePolicyResponse": {
      "type": "object",
      "properties": {
        "policy": {
          "$ref": "#/definitions/policy"
