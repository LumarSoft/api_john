        "offeringCode": {
          "type": "string",
          "example": 4,
          "description": "Módulo de cobertura"
        },
        "respectClientIvaCondition": {
          "type": "boolean"
        },
        "endEffectiveDate": {
          "type": "string",
          "description": "Fecha fin de vigencia",
          "example": "2025-03-19"
        }
      },
      "required": [
        "locationRisk",
        "producerNumber",
        "startEffectiveDate"
