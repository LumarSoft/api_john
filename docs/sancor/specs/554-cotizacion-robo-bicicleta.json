          "example": 100212
        },
        "startEffectiveDate": {
          "type": "string",
          "description": "Fecha de inicio vigencia.",
          "example": "2024-10-19"
        },
        "relationQuotationCode": {
          "type": "integer",
          "x-nullable": true
        },
        "clients": {
          "type": "object",
          "properties": {
            "documentNumber": {
              "type": "integer",
              "description": "Numero Documento",
              "example": 42055099
            },
            "documentType": {
              "type": "string",
              "description": "Tipo documento",
              "example": "D",
