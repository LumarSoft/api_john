            }
          },
          "400": {
            "description": "Invalid or misspelled input parameter error.",
            "schema": {
              "$ref": "#/definitions/Messages"
            }
          },
          "401": {
            "description": "Authorization.",
            "schema": {
              "$ref": "#/definitions/Messages"
            }
          },
          "403": {
            "description": "Authentication.",
            "schema": {
              "$ref": "#/definitions/Messages"
            }
          },
          "415": {
            "description": "Mandatory parameters missing.",
            "schema": {
              "$ref": "#/definitions/Messages"
            }
