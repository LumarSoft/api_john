              "type": "integer",
              "description": "Condición ante el IVA",
              "example": 4,
              "enum": [
                "1 - Responsable Inscripto",
                "2 - Responsable No Inscripto",
                "3 - Exento",
                "4 - Consumidor Final",
                "5 - No Declarado",
                "6 - No Alcanzado",
                "7 - Responsable Monotribuito",
                "8 - Sujeto No Categorizado"
