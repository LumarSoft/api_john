                "identificationNumber": {
                  "type": "integer",
                  "description": "Numero Documento",
                  "example": 42055099
                },
                "identificationType": {
                  "type": "string",
                  "description": "Tipo documento",
                  "example": "D",
                  "enum": [
                    "D - DNI",
                    " C - LC",
                    " L - LE",
                    " I - CI",
                    " J - CUIT"
                  ]
                },
                "isJuridicPerson": {
                  "type": "boolean",
                  "description": "Persona jurídica(true/false)"
                }
              },
              "required": [
                "isJuridicPerson",
                "identificationType"
              ],
              "description": "Dato de cliente."
            },
            "coverModuleCodes": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "offeringCode": {
                    "type": "integer",
                    "description": "Código de modulo",
                    "example": 4
                  }
                }
              },
              "description": "Lista de modulos"
            },
            "currencyCode": {
              "type": "integer",
              "description": "Código moneda",
              "example": 1
            },
            "discountCustomizations": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "discountCode": {
                    "type": "integer",
                    "description": "Descuento Especial Comercial",
                    "enum": [
                      "58- Descuento especial",
                      "90- Descuento especial NEO",
                      "173- Descuento Promocional"
                    ]
                  },
                  "percentage": {
                    "type": "number",
                    "format": "",
                    "description": "Porcentaje descuento"
                  }
                }
              },
              "description": "Descuentos"
            },
