                        "sa_02",
                        "sa1_plus",
                        "sa2_plus"
                      ]
                    },
                    "assistanceProvider": {
                      "type": "string",
                      "description": "Código de provedor.",
                      "enum": [
                        "ibero"
                      ]
                    }
