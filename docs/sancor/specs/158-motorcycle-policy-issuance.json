        "prodProducerCode": {
          "type": "integer",
          "description": "Número de Intermediario \"Productor\""
        },
        "productCode": {
          "type": "integer",
          "description": "Código de Producto de la póliza"
        },
        "policyRenewalType": {
          "type": "integer",
          "description": "Tipo de Renovación de la póliza"
        },
        "statisticalGroupCode": {
          "type": "integer"
