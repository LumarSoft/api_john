              "properties": {
                "policyAutomaticAdjustment": {
                  "type": "number",
                  "format": "decimal",
                  "description": "Descuento Siniestralidad",
                  "enum": [
                    "Option_10",
                    "Option_20",
                    "Option_30",
                    "Option_40"
                  ]
                },
                "motorcycle": {
                  "type": "object",
                  "properties": {
                    "chassisNumber": {
                      "type": "string",
                      "description": "Número de Chasis"
                    },
                    "licensePlate": {
                      "type": "string",
                      "description": "Número de Patente"
                    },
                    "engineNumber": {
                      "type": "string",
                      "description": "Número de Motor"
                    },
                    "modelCode": {
                      "type": "integer",
