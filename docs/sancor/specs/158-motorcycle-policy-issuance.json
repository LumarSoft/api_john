                "contractStartEffectiveDate": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de Efecto del contrato"
                },
                "contractEndEffectiveDate": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de Vencimiento/Fin del contrato"
                },
                "quotaToPayDueDate": {
                  "type": "string",
                  "format": "date-time",
                  "description": "Fecha de Vencimiento de la primera cuota"
                },
                "idOperation": {
                  "type": "string"
                },
                "policyQuotas": {
                  "type": "integer",
                  "description": "Cantidad de Cuotas del contrato"
                }
              },
              "description": "Etiqueta de Operatoria Especial"
