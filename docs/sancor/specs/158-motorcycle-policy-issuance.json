{
  "swagger": "2.0",
  "info": {
    "version": "1.0.0",
    "description": "Servicio para emitir pólizas del ramo moto vehículos",
    "x-ibm-name": "motorcycle-policy-issuance",
    "title": "Emisión Motovehículos",
    "x-ibm-summary": ""
  },
  "paths": {
