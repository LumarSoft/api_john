                  },
                  "coverageName": {
                    "type": "string"
                  },
                  "coverageDescription": {
                    "type": "string"
                  },
                  "coverageCode": {
                    "type": "integer"
                  },
                  "isObligatorySelection": {
                    "type": "boolean"
                  },
                  "isSelected": {
                    "type": "boolean"
                  },
                  "optionName": {
                    "type": "string"
                  },
                  "optionCode": {
                    "type": "integer"
                  }
