                      "bupId": {
                        "type": "string"
                      },
                      "identificationTypeName": {
                        "type": "string",
                        "description": "Tipo de Documento",
                        "enum": [
                          "D - DNI",
                          "C - LC",
                          "L - LE",
                          "I - CI",
                          "J - CUIT"
                        ]
                      },
                      "identificationType": {
                        "type": "string",
                        "description": "Nro. de Documento"
                      },
                      "email": {
                        "type": "string",
                        "description": "Dirección de e-mail"
