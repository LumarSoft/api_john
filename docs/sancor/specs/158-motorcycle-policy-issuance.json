                      "telephoneNumber": {
                        "type": "string",
                        "description": "Número de Teléfono"
                      },
                      "taxCategoryCode": {
                        "type": "integer"
                      },
                      "streetName": {
                        "type": "string",
                        "description": "Dirección (Domicilio) del Cliente (Calle-Nro.)"
                      },
                      "cityPostalCode": {
                        "type": "integer",
                        "description": "Código Postal del Domicilio del Cliente"
                      }
