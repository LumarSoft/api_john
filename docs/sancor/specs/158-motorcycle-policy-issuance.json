            "surchargeDiscounts": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "discountAmount": {
                    "type": "number",
                    "format": "decimal"
                  },
                  "discountRate": {
                    "type": "number",
                    "format": "decimal"
                  },
                  "discountCode": {
                    "type": "integer"
                  }
                }
              }
            },
            "policyPeriodEndEffectiveDate": {
              "type": "string",
              "format": "date-time",
              "description": "Vigencia HASTA de la póliza"
