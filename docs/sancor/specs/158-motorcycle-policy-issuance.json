                  "issueTransactionPremium": {
                    "type": "integer",
                    "format": "decimal"
                  },
                  "quotaAmount": {
                    "type": "integer",
                    "format": "decimal"
                  }
                }
              }
            },
            "receiptNumber": {
              "type": "integer"
            }
          }
        },
        "referenceNumber": {
          "type": "integer"
        }
      }
