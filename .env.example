DATABASE_URL="mysql://root:<password>@localhost:3306/john_db"
JWT_SECRET="change_me_to_a_strong_random_secret"
PORT=3001

# Shared secret for the WhatsApp bot (/bot/* endpoints). Same value in whatsapp-bot-seguros/.env
BOT_SECRET=dev

# Meta phone number ID the seed registers for producer "John". Set it to your own
# WhatsApp test number's phone_number_id so the bot resolves your inbound messages.
SEED_PHONE_NUMBER_ID=TEST_META_PHONE_ID

# Days of bot chat history to keep — the daily retention job hard-deletes older messages (default 30)
MESSAGE_RETENTION_DAYS=30
COEXISTENCE_HISTORY_RETENTION_DAYS=180

TRIUNFO_CARTERA_SYNC_ENABLED=false   # Set to true in production
TRIUNFO_CARTERA_SYNC_ON_BOOT=false   # true also syncs on every start; by default only at 06:00 and 20:00
# Lookback windows for the cartera sync, in months. The first sync of each
# producer code uses BACKFILL; every later run uses INCREMENTAL. Each range is
# split into 7-day calls internally (a wider single call does not come back),
# so every extra month is ~4 more Triunfo requests per code.
TRIUNFO_CARTERA_BACKFILL_MONTHS=6
TRIUNFO_CARTERA_INCREMENTAL_MONTHS=3

# PROD: https://servicios.triunfonet.com.ar/gauswebtriunfosrv/rest
#       https://www.triunfonet.com.ar/sipv1/rest
# TEST: https://apitest.triunfonet.com.ar/gauswebtriunfotest/rest
#       https://siptest.triunfonet.com.ar/wsv1/rest
TRIUNFO_BASE_URL_AUTH=https://apitest.triunfonet.com.ar/gauswebtriunfotest/rest
TRIUNFO_BASE_URL_SIP=https://siptest.triunfonet.com.ar/wsv1/rest
TRIUNFO_PRODUCTOR=
TRIUNFO_USUARIO=
TRIUNFO_PASSWORD=

# PROD: https://api.infoauto.com.ar/cars/pub
#       https://api.infoauto.com.ar/cars/auth
# DEMO: https://demo.api.infoauto.com.ar/cars/pub
#       https://demo.api.infoauto.com.ar/cars/auth
INFOAUTO_BASE_URL=https://api.infoauto.com.ar/cars/pub
INFOAUTO_AUTH_URL=https://api.infoauto.com.ar/cars/auth
# Catálogo de motos (producto separado de InfoAuto).
INFOAUTO_MOTO_BASE_URL=https://api.infoauto.com.ar/motorcycles/pub
INFOAUTO_MOTO_AUTH_URL=https://api.infoauto.com.ar/motorcycles/auth
INFOAUTO_EMAIL=
INFOAUTO_PASSWORD=
# Opcionales cuando InfoAuto entrega credenciales diferentes para motos.
# Si quedan vacías se reutilizan INFOAUTO_EMAIL / INFOAUTO_PASSWORD.
INFOAUTO_MOTO_EMAIL=
INFOAUTO_MOTO_PASSWORD=

# La suscripción incluye el catálogo pero NO la valuación: list_price, prices,
# photos, batch y archives devuelven 403 en producción. Con esto en false,
# InfoAutoService.getVehicleValue() no sale a la red y el cotizador manda
# Valor: "0", que hace que Triunfo resuelva el valor de mercado por su cuenta y
# lo devuelva en DatosAdicionales.ValorVehiculo.
# Ver docs/production-migration.md
INFOAUTO_PRICES_ENABLED=false

# Costos del modelo usado por el bot (GPT-5.6 Luna), USD por 1M tokens.
OPENAI_PRICE_IN_PER_1M=0.20
OPENAI_PRICE_OUT_PER_1M=1.20
OPENAI_PRICE_CACHED_PER_1M=0.02
# Meta: tabla USD de octubre 2026; los mensajes gratuitos se identifican por webhook.
META_DEFAULT_MARKET=Argentina

# ── Mail (Resend) ──
RESEND_API_KEY=                       # Resend API key (vacío = se loguea, no se envía)
MAIL_FROM=onboarding@resend.dev       # Remitente verificado en Resend
ADVISOR_EMAIL=                        # Destinatario de avisos de siniestros (asesor)

# Aviso al dueño cuando alguien apaga/enciende el bot (switch global).
# Sin configurar, el aviso solo se loguea (el cambio igual queda auditado en BotStatusChange).
BOT_STATUS_ALERT_EMAIL=               # Uno o más mails separados por coma
BOT_STATUS_ALERT_PHONE=               # Número de WhatsApp del dueño (ej. 5493410000000)
BOT_STATUS_ALERT_TEMPLATE=            # Plantilla aprobada por Meta con 3 variables: quién, "desactivó"/"activó", cuándo
BOT_STATUS_ALERT_TEMPLATE_LANG=es_AR

# Sección Rechazos: aviso por WhatsApp a cada cliente del Excel de débitos rechazados de Triunfo.
# Plantilla aprobada por Meta (Servicio) con 6 variables: nombre, cuota, póliza, vencimiento, importe, motivo.
# Vacío = se puede cargar el Excel pero no enviar avisos.
PAYMENT_REJECTION_TEMPLATE=           # aviso_rechazo_pago
PAYMENT_REJECTION_TEMPLATE_LANG=es_AR

# Cobranzas → Pólizas vencidas: aviso por WhatsApp de que la póliza venció, con invitación a renovar.
# Plantilla aprobada por Meta (Utility) con 5 variables: nombre, organización, póliza, patente o producto, fecha.
# Vacío = la lista funciona pero no se pueden enviar avisos (sí marcarlos como avisados a mano).
POLICY_EXPIRY_TEMPLATE=               # aviso_poliza_vencida
POLICY_EXPIRY_TEMPLATE_LANG=es_AR

# Devolución automática de un chat tomado por una persona (inbox o app de WhatsApp).
# En horario de atención el chat vuelve al bot cuando nadie escribió por QUIET minutos,
# o cuando la persona lleva MAX minutos sin responder. Fuera de horario, a los TIMEOUT
# minutos sin respuesta de la persona.
BOT_TAKEOVER_TIMEOUT_MINUTES=30
BOT_TAKEOVER_QUIET_MINUTES=120
BOT_TAKEOVER_MAX_MINUTES=120

# ── Planes por tokens, por número (se facturan a mes vencido) ──
# 1 token = 1 mensaje enviado por la plataforma (bot o panel), aunque Meta no lo cobre.
# Precio fijo por token: cada plan del catálogo (Facturación → Planes, lo arma el
# SuperAdmin) vale tokens × precio (500 = USD 25, 1.000 = USD 50). Pasado el plan
# más grande se cobra en bloques de COMMERCIAL_TOKEN_BLOCK_SIZE al mismo precio.
COMMERCIAL_TOKEN_PRICE_USD=0.05
COMMERCIAL_TOKEN_BLOCK_SIZE=1000
# Plan Prueba: tokens gratis en el primer mes de cada número de una cuenta nueva
# (organización creada desde COMMERCIAL_TRIAL_FROM). 0 = sin prueba.
COMMERCIAL_TRIAL_TOKENS=100
COMMERCIAL_TRIAL_FROM=2026-10-29

# ── Meta / WhatsApp Embedded Signup ──
# App de Meta que corre el onboarding (Panel de la app -> Configuracion -> Basica).
META_APP_ID=
META_APP_SECRET=
# config_id de la configuracion de "Inicio de sesion con Facebook para empresas".
# Sin este valor el boton "Conectar numero de WhatsApp" no aparece.
META_ES_CONFIG_ID=
# Version de Graph API. El bot ya usa v25.0: manteneelas iguales.
META_GRAPH_VERSION=v25.0
# Clave AES-256 (64 hex) para cifrar los business tokens de cada WABA.
# Generala con: openssl rand -hex 32
WABA_TOKEN_ENCRYPTION_KEY=
# Aviso cuando Meta desconecta un número de la API (Coexistence caída). Si está
# vacío usa BOT_STATUS_ALERT_EMAIL y después ADVISOR_EMAIL.
WHATSAPP_ALERT_EMAIL=                 # Uno o más mails separados por coma
WHATSAPP_CONNECTION_CHECK_ENABLED=true # Chequeo contra Meta cada 30 min; false lo apaga
