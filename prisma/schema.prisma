// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── ORGANIZATION (tenant) ───────────────────────────────
// `Producer` is the unit of tenancy = the billable ORGANIZATION you sell to
// (e.g. "JOHN PELLEGRINI MANAGEMENT GROUP SRL", master code 11425). It is NOT
// a single insurance agent. Each real Triunfo agent code (8074, 14831, ...) is a
// `ProducerCode` child of this organization. Naming caveat: in code "Producer"
// means the organization/tenant; "ProducerCode" means the Triunfo agent code.
// (Kept the name `Producer` to avoid a destabilizing rename — see CONTEXT.md.)

model Producer {
  id            Int       @id @default(autoincrement())
  name          String
  slug          String    @unique
  // The organization's principal Triunfo code (e.g. "11425"). The cartera of every
  // dependent code rolls up to this org. Informational/anchor for the master code.
  masterCode    String?   @db.VarChar(20)
  // Display name the WhatsApp bot uses to introduce itself (per branch/tenant).
  // Null/empty → the bot introduces itself as "el asistente de <org>".
  botName       String?   @db.VarChar(60)
  // First names of the office people customers write to by name ("Mili,
  // Milagros"), comma separated. A message that names one of them alerts the
  // office, and the bot keeps attending the customer.
  staffNames    String?   @db.VarChar(255)
  // Organization-wide emergency switch. False stops every automated WhatsApp
  // response while inbound messages continue to be stored in the inbox.
  botEnabled    Boolean   @default(true)
  // Weekly business hours (Mon–Sun) shown across every channel (WhatsApp bot and
  // the public web) and used to compute "open now". Single source of truth edited
  // from the admin "Horarios" screen. JSON shape: { mon: [{from,to}], ..., sun: [] }
  // where each day holds zero or more HH:mm ranges ([] = closed). Null → app default.
  businessHours Json?
  // How the bot names the organization and what it tells customers about
  // assistance and payments (grúa line, claims line, transfer account, where to
  // pay cash), edited from "Configuración". Flat JSON, see
  // src/common/bot-profile.ts. Null → the bot's own defaults.
  botProfile    Json?
  systemPrompt  String    @db.Text
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  producerCodes           ProducerCode[]
  phoneNumbers            PhoneNumber[]
  wabaAccounts            WabaAccount[]
  users                   User[]
  clients                 Client[]
  policies                Policy[]
  quotes                  Quote[]
  conversations           Conversation[]
  claims                  Claim[]
  notifications           Notification[]
  contactLeads            ContactLead[]
  productPlans            ProductPlan[]
  businessClosures        BusinessClosure[]
  usageMonthly            UsageMonthly[]
  coverageSettings        CoverageSetting[]
  botStatusChanges        BotStatusChange[]
  improvements            Improvement[]
  proposals               ImprovementProposal[]
  tasks                   Task[]
  paymentRejectionImports PaymentRejectionImport[]
  paymentRejections       PaymentRejection[]
  policyExpiryNotices     PolicyExpiryNotice[]
  triunfoCredential       TriunfoCredential?
}

// ─── BOT STATUS AUDIT ────────────────────────────────────
// One row per flip of the organization-wide bot switch (Producer.botEnabled),
// so the owner can see who turned the bot off, when and for how long. The
// switch itself used to leave no trace at all.
model BotStatusChange {
  id         Int       @id @default(autoincrement())
  botEnabled Boolean
  createdAt  DateTime  @default(now())
  deletedAt  DateTime?

  producerId    Int
  producer      Producer     @relation(fields: [producerId], references: [id])
  // Admin who flipped the switch. Null when it did not come from a logged-in user.
  userId        Int?
  user          User?        @relation(fields: [userId], references: [id])
  // The number the flip was for; null = the organization-wide switch.
  phoneNumberId Int?
  phoneNumber   PhoneNumber? @relation(fields: [phoneNumberId], references: [id])

  @@index([producerId, createdAt])
  @@index([userId])
  @@index([phoneNumberId])
}

// ─── MEJORAS ─────────────────────────────────────────────
// What changed in the platform, written for the office (not a technical
// changelog). Lumar (OWNER) writes and publishes them; the organization's
// users read them in "Mejoras" and see a count of the ones they haven't opened.

enum ImprovementArea {
  BOT
  BANDEJA
  COTIZADOR
  PANEL
  PORTAL
}

model Improvement {
  id          Int             @id @default(autoincrement())
  title       String          @db.VarChar(140)
  // One or two sentences shown on the card.
  summary     String          @db.VarChar(500)
  // "Antes / ahora": what used to happen and what happens now. Optional because
  // a brand new feature has no "before".
  beforeText  String?         @db.Text
  afterText   String?         @db.Text
  // A short real-looking exchange that shows the change (one line per message).
  example     String?         @db.Text
  area        ImprovementArea
  // When the change reached the office (shown on the card). Kept apart from
  // publishedAt so an older improvement published today keeps its real date.
  releasedOn  DateTime?       @db.Date
  // Null = draft, only the OWNER sees it. Set = visible since then; whatever was
  // published after a user's last visit counts as new for them.
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  deletedAt   DateTime?

  // Null = shown to every organization.
  producerId Int?
  // Restrict: a deleted organization must never turn its improvements global.
  producer   Producer? @relation(fields: [producerId], references: [id], onDelete: Restrict)

  @@index([producerId, publishedAt])
}

// Ideas the organization's users send to Lumar from "Mejoras". Every user of
// the organization sees every proposal (a shared board, so nobody proposes the
// same thing twice); Lumar answers and moves them through the statuses.

enum ProposalStatus {
  NEW
  REVIEWING
  PLANNED
  DONE
  DISCARDED
}

model ImprovementProposal {
  id          Int            @id @default(autoincrement())
  title       String         @db.VarChar(140)
  description String         @db.Text
  status      ProposalStatus @default(NEW)
  // Lumar's answer, shown to the whole organization.
  response    String?        @db.Text
  respondedAt DateTime?
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  deletedAt   DateTime?

  producerId Int
  producer   Producer @relation(fields: [producerId], references: [id])
  // Who proposed it. Null if that user is later removed.
  authorId   Int?
  author     User?    @relation(fields: [authorId], references: [id])

  @@index([producerId, createdAt])
  @@index([status])
}

/// How a Triunfo auto coverage is shown in the quote results — one row per
/// coverage code, editable from the admin "Coberturas" screen.
///
/// Which coverages Triunfo quotes for a given vehicle/year is Triunfo's call and
/// is not configurable. This model decides, among the ones it did quote, which
/// are shown, in what order and with what commercial wording.
///
/// Rows are created by discovery: every code seen in a quote is registered with
/// `isConfigured = false` so the admin screen lists real codes instead of asking
/// someone to type them blind. A brand new code is visible by default — hiding it
/// silently would lose sales without anyone noticing.
model CoverageSetting {
  id                Int       @id @default(autoincrement())
  code              String    @db.VarChar(10) // Triunfo coverage code: "A", "B1", "C1"...
  name              String    @db.VarChar(80) // commercial name shown to the client
  tagline           String?   @db.VarChar(160)
  benefits          Json // string[] — bullet list shown on the card
  exclusions        Json? // string[] — what it does not cover; null = the code's default list
  isActive          Boolean   @default(true) // shown in the quote results
  isConfigured      Boolean   @default(false) // false until someone edits it in admin
  highlighted       Boolean   @default(false) // "La más elegida" badge
  sortOrder         Int       @default(0)
  // Optional vehicle-year window. Null on both ends = every year.
  yearFrom          Int?
  yearTo            Int?
  // Years for which a highlighted coverage is the recommended one (badge and
  // first place). Null on both ends = every year the coverage is offered.
  highlightYearFrom Int?
  highlightYearTo   Int?
  firstSeenAt       DateTime  @default(now())
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  producerId Int
  producer   Producer @relation(fields: [producerId], references: [id])

  @@unique([producerId, code])
  @@index([producerId, isActive])
}

// ─── PRODUCER CODE (Triunfo agent code) ──────────────────
// A single Triunfo "código de productor" that belongs to an organization. The
// cartera (clients/policies/cuotas) is keyed by this code in Triunfo, so it is a
// first-class scoping unit. Admin users are granted visibility over one or more
// of these via UserProducerCode; a SuperAdmin implicitly sees all codes of its org.
model ProducerCode {
  id                Int       @id @default(autoincrement())
  // Triunfo agent code, e.g. "8074". Unique within an organization.
  code              String    @db.VarChar(20)
  // Human-readable holder, e.g. "PELLEGRINI JOHN" / "CANARELLI ADRIANA".
  holderName        String?
  // True for the organization's principal code (mirrors Producer.masterCode).
  isMaster          Boolean   @default(false)
  isActive          Boolean   @default(true)
  // Last successful cartera sync for this code. Null = never synced, which makes
  // the next run use the full backfill window (6 months) instead of the
  // incremental one (3 months). See CarteraSyncService.buildDateRange.
  lastCarteraSyncAt DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  producerId Int
  producer   Producer @relation(fields: [producerId], references: [id])

  users                UserProducerCode[]
  clients              Client[]
  policies             Policy[]
  quotes               Quote[]
  claims               Claim[]
  contactLeads         ContactLead[]
  conversations        Conversation[]
  notifications        Notification[]
  // Phone numbers whose billing is attributed to this code.
  responsibleForPhones PhoneNumber[]             @relation("phone_responsible_code")
  // Phone numbers this code is served by (many-to-many, e.g. shared office line).
  servedByPhones       PhoneNumberProducerCode[]
  usageMonthly         UsageMonthly[]
  paymentRejections    PaymentRejection[]
  policyExpiryNotices  PolicyExpiryNotice[]

  @@unique([producerId, code])
  @@index([producerId, isActive])
}

// ─── USER ↔ PRODUCER CODE (visibility grants) ────────────
// Which producer codes an ADMIN user may see. SuperAdmin needs no rows here
// (resolved at runtime to all codes of the org). An admin always implicitly sees
// at least the code(s) granted here; the SuperAdmin manages these grants.
model UserProducerCode {
  id             Int          @id @default(autoincrement())
  userId         Int
  user           User         @relation(fields: [userId], references: [id])
  producerCodeId Int
  producerCode   ProducerCode @relation(fields: [producerCodeId], references: [id])
  createdAt      DateTime     @default(now())

  @@unique([userId, producerCodeId])
  @@index([producerCodeId])
}

// A temporary closure (holiday, vacation, etc.) that overrides the weekly hours
// for a date or date range. The bot surfaces the `reason` to anyone asking about
// hours while the closure is active. Single-day closures use startDate == endDate.
model BusinessClosure {
  id        Int       @id @default(autoincrement())
  startDate DateTime  @db.Date
  endDate   DateTime  @db.Date
  // Why the office is closed (required) — quoted back to users by the bot.
  reason    String    @db.VarChar(160)
  // Null = loaded by an admin. "holiday" = an Argentine national holiday loaded
  // by HolidaySyncService; a deleted one stays deleted (the sync sees it and
  // does not create it again), so an admin can open on a holiday.
  source    String?   @db.VarChar(16)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  producerId Int
  producer   Producer @relation(fields: [producerId], references: [id])

  @@index([producerId, startDate, endDate])
  @@index([source, startDate])
}

model PhoneNumber {
  id            Int       @id @default(autoincrement())
  phoneNumberId String    @unique // ID de Meta
  number        String // display: "+1 555 151 7253"
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  producerId    Int
  producer      Producer  @relation(fields: [producerId], references: [id])

  // WABA this number belongs to. Holds the business token used to send messages,
  // so the token is resolved PER NUMBER instead of coming from the environment —
  // with two tenants a single WHATSAPP_TOKEN cannot work. Nullable while the
  // legacy test number (registered by hand) is still around.
  wabaAccountId Int?
  wabaAccount   WabaAccount? @relation(fields: [wabaAccountId], references: [id])

  // Billing: the code this number is invoiced to. A number may serve several
  // codes (shared office line), but exactly one is the "responsible" for billing.
  // We bill per active PhoneNumber, attributed to this code. Nullable during
  // migration; should be set for every production number.
  responsibleProducerCodeId Int?
  responsibleProducerCode   ProducerCode?             @relation("phone_responsible_code", fields: [responsibleProducerCodeId], references: [id])
  // All codes this number routes/serves (many-to-many).
  servedCodes               PhoneNumberProducerCode[]

  // Monthly cost cap in USD for this number (OpenAI + Meta). Null → platform
  // default (DEFAULT_MONTHLY_BUDGET_USD env). When the running month total
  // crosses the cap, budgetExceededAt is stamped and the bot disables the (paid)
  // LLM while the deterministic flows keep working at zero token cost.
  monthlyBudgetUsd Decimal?  @db.Decimal(10, 2)
  budgetExceededAt DateTime?

  usageEvents      UsageEvent[]
  usageMonthly     UsageMonthly[]
  whatsappContacts WhatsAppContact[]

  // Last Coexistence payload successfully persisted for this number. These
  // timestamps make the post-onboarding production check observable instead of
  // relying on transient application logs.
  historyLastSyncedAt  DateTime?
  contactsLastSyncedAt DateTime?

  // The number's own assistant, for a branch or a producer that answers on its
  // own line. Each one left null takes the organization's value (same field on
  // Producer), so a number nobody configured behaves exactly as before.
  botName          String?           @db.VarChar(60)
  staffNames       String?           @db.VarChar(255)
  businessHours    Json?
  // Only the Producer.botProfile fields this number changes (same flat shape).
  botProfile       Json?
  // The number's own switch: false stops the bot on this number only (the
  // organization's switch, Producer.botEnabled, stops every number). The
  // admin of the number flips it; every flip is a BotStatusChange row.
  botEnabled       Boolean           @default(true)
  // The number's view of the organization's coverages: { "<code>": { isActive,
  // highlighted, sortOrder } } with only the fields it changes. Wording and
  // year windows stay the organization's. Null = offers them as the organization does.
  coverageSettings Json?
  botStatusChanges BotStatusChange[]

  @@index([responsibleProducerCodeId])
  @@index([wabaAccountId])
}

// Monthly cost aggregate per phone number (one row per number per "YYYY-MM").
// Incremented as the bot reports OpenAI token usage and Meta conversations, so
// reporting per number/código/org/month is a cheap indexed read. producerId and
// producerCodeId are denormalized from the PhoneNumber at write time.
model UsageMonthly {
  id                      Int      @id @default(autoincrement())
  period                  String   @db.VarChar(7) // "YYYY-MM"
  openaiCalls             Int      @default(0)
  openaiCachedInputTokens Int      @default(0)
  metaMessages            Int      @default(0)
  metaBillableMessages    Int      @default(0)
  openaiInputTokens       Int      @default(0)
  openaiOutputTokens      Int      @default(0)
  openaiCostUsd           Decimal  @default(0) @db.Decimal(12, 6)
  metaConversations       Int      @default(0)
  metaCostUsd             Decimal  @default(0) @db.Decimal(12, 6)
  // What the number COSTS us (OpenAI + Meta). Measured, never adjusted.
  totalCostUsd            Decimal  @default(0) @db.Decimal(12, 6)
  // What the client is INVOICED for this number this month:
  //   commercial token/message tariff, prorated monthly minimum and full-month cap
  // A business rule, not a measurement — kept in its own column precisely so the
  // measured cost above stays truthful and the margin is visible.
  billedUsd               Decimal  @default(0) @db.Decimal(12, 2)
  createdAt               DateTime @default(now())
  updatedAt               DateTime @updatedAt

  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])
  phoneNumberId  Int
  phoneNumber    PhoneNumber   @relation(fields: [phoneNumberId], references: [id])

  @@unique([period, phoneNumberId])
  @@index([producerId, period])
  @@index([producerCodeId, period])
}

// Durable deduplication: retries and delivered/read callbacks bill only once.
model UsageEvent {
  id            Int         @id @default(autoincrement())
  eventId       String      @db.VarChar(191)
  provider      String      @db.VarChar(20)
  phoneNumberId Int
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id])
  period        String      @db.VarChar(7)
  category      String      @db.VarChar(40)
  billable      Boolean
  costUsd       Decimal     @db.Decimal(12, 6)
  deliveredAt   DateTime

  @@unique([phoneNumberId, eventId])
  @@index([phoneNumberId, period])
}

// Join: which producer codes a single WhatsApp number serves. Lets several codes
// (e.g. coworkers in the same office) share one number while we still attribute
// billing to `PhoneNumber.responsibleProducerCode`.
model PhoneNumberProducerCode {
  id             Int          @id @default(autoincrement())
  phoneNumberId  Int
  phoneNumber    PhoneNumber  @relation(fields: [phoneNumberId], references: [id])
  producerCodeId Int
  producerCode   ProducerCode @relation(fields: [producerCodeId], references: [id])

  @@unique([phoneNumberId, producerCodeId])
  @@index([producerCodeId])
}

// ─── ADMINS / SUPERADMINS DE LA ORGANIZACIÓN ─────────────

// Platform/organization roles.
//   OWNER      → the platform operator (Lumar). Logs into the same admin panel as
//                a super-superadmin: behaves as SUPERADMIN everywhere PLUS can
//                provision organizations (create Producer + its codes + its first
//                SuperAdmin) from the owner-only "Organizaciones" screen. Homed at
//                an organization for convenience but not bound by org-management.
//   SUPERADMIN → sees ALL producer codes of its org; manages admins & grants.
//   ADMIN      → sees only the producer codes granted via UserProducerCode.
enum Role {
  OWNER
  SUPERADMIN
  ADMIN
}

model User {
  lastNotificationsVisitAt DateTime?
  // Last time this user opened "Mejoras": anything published after it is new to them.
  lastImprovementsVisitAt  DateTime?
  id                       Int       @id @default(autoincrement())
  email                    String    @unique
  // How the office calls this person ("Mili"). Optional: falls back to the email.
  name                     String?   @db.VarChar(80)
  password                 String
  role                     Role      @default(ADMIN)
  createdAt                DateTime  @default(now())
  updatedAt                DateTime  @updatedAt
  deletedAt                DateTime?

  producerId              Int
  producer                Producer                 @relation(fields: [producerId], references: [id])
  // Producer codes this admin may access (ignored for SUPERADMIN = all codes).
  producerCodes           UserProducerCode[]
  quotes                  Quote[]
  assignedConversations   Conversation[]           @relation("assigned_conversations")
  botStatusChanges        BotStatusChange[]
  proposals               ImprovementProposal[]
  tasksCreated            Task[]                   @relation("tasks_created")
  tasksAssigned           Task[]                   @relation("tasks_assigned")
  taskComments            TaskComment[]
  paymentRejectionImports PaymentRejectionImport[]
  policiesHidden          Policy[]                 @relation("policies_hidden")
  paymentRejectionsSent   PaymentRejection[]
  policyExpiryNoticesSent PolicyExpiryNotice[]     @relation("policy_expiry_notices_sent")
}

// ─── CLIENTES ASEGURADOS ─────────────────────────────────

model Client {
  id                     Int       @id @default(autoincrement())
  dni                    String
  firstName              String
  lastName               String
  // Null when Triunfo has no email for the client. Synthetic "<dni>@cliente.local"
  // addresses used to fill it in: they ended up as 40% of all clients.
  email                  String?
  password               String
  requiresPasswordChange Boolean   @default(true)
  phone                  String?
  city                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  producerId          Int
  producer            Producer             @relation(fields: [producerId], references: [id])
  // Triunfo agent code that owns this client's cartera. Nullable during migration;
  // back-filled to the org master code, then refined per Triunfo cartera.
  producerCodeId      Int?
  producerCode        ProducerCode?        @relation(fields: [producerCodeId], references: [id])
  conversations       Conversation[]
  policies            Policy[]
  claims              Claim[]
  notifications       Notification[]
  paymentRejections   PaymentRejection[]
  policyExpiryNotices PolicyExpiryNotice[]

  @@unique([email, producerId])
  @@unique([dni, producerId])
  @@unique([phone, producerId])
  @@index([producerCodeId])
}

// ─── PÓLIZAS ─────────────────────────────────────────────

enum RiskType {
  auto
  moto
  home
  life
  commercial
  other
}

model Policy {
  id                Int       @id @default(autoincrement())
  certificateNumber String // Triunfo's certificate number
  endorsementNumber Int       @default(0) // Triunfo's suplemento: the policy version
  company           String // "triunfo" — expandable for future companies
  riskType          RiskType  @default(other)
  // Triunfo's last movement on the policy ("REFACTURACION", "ANULA POR VENTA",
  // "RENOVACION"…), not its status: validity is computed from the dates and
  // this movement (see common/poliza-vigencia.ts).
  lastMovement      String
  validFrom         DateTime?
  validTo           DateTime?
  premium           Decimal?  @db.Decimal(12, 2)
  paymentMethod     String?
  rawData           Json // full provider response for this policy
  // Taken out of the "pólizas vencidas" worklist by hand: the office knows
  // it will not be renewed (vehicle sold, insured elsewhere…). The cartera
  // sync never touches these, so the choice survives every novedad.
  hiddenAt          DateTime?
  hiddenReason      String?
  hiddenById        Int?
  hiddenBy          User?     @relation("policies_hidden", fields: [hiddenById], references: [id])
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  deletedAt         DateTime?

  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id])
  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  // Triunfo agent code that owns this policy (cartera is keyed by code in Triunfo).
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])

  vehicle           Vehicle?
  installments      Installment[]
  claims            Claim[]
  paymentRejections PaymentRejection[]
  expiryNotices     PolicyExpiryNotice[]

  @@unique([certificateNumber, producerId])
  @@index([producerCodeId])
}

model Vehicle {
  id                Int       @id @default(autoincrement())
  licensePlate      String?
  brand             String?
  model             String?
  version           String?
  year              Int?
  // InfoAuto identity, as Triunfo reports it in SDTVehiculoDatos.
  // codia = infoautoBrandCode * 10000 + infoautoModelCode — verified against the whole InfoAuto
  // catalog (13.082 models, no exceptions). Keeping it lets us go back to
  // InfoAuto from a policy for the spec sheet, the photo or a value refresh.
  infoautoBrandCode Int?
  infoautoModelCode Int?
  codia             Int?
  type              String? // "AUTOMOVIL" | "MOTO" etc.
  usage             String? // "PARTICULAR" | "COMERCIAL" etc.
  coverage          String? // coverage code (e.g. "A", "B", "C")
  sumInsured        Decimal?  @db.Decimal(14, 2)
  isZeroKm          Boolean   @default(false)
  chassisNumber     String?
  engineNumber      String?
  deletedAt         DateTime?

  policyId Int    @unique
  policy   Policy @relation(fields: [policyId], references: [id])
}

enum InstallmentStatus {
  pending
  paid
  overdue
  rejected
}

model Installment {
  id             Int               @id @default(autoincrement())
  number         Int
  amount         Decimal           @db.Decimal(12, 2)
  dueDate        DateTime?
  status         InstallmentStatus @default(pending)
  // Triunfo's own cuota state as it came ("PENDIENTE", "PAGADA", "ANULADA",
  // "EN PRELIQUIDACIÓN"…), kept beside our status: an ANULADA cuota is soft
  // deleted and one EN PRELIQUIDACIÓN (sent to the bank) is never overdue.
  providerStatus String?
  deletedAt      DateTime?

  policyId Int
  policy   Policy @relation(fields: [policyId], references: [id])

  @@unique([policyId, number])
}

// ─── SINIESTROS (denuncias del cliente) ──────────────────

enum ClaimStatus {
  pending
  in_progress
  resolved
}

model Claim {
  id                 Int         @id @default(autoincrement())
  // Category the client picked: "auto" | "moto" | "hogar" | "robo" | "otro".
  type               String
  description        String      @db.Text
  // When the incident happened (not when it was reported: that is createdAt).
  occurredAt         DateTime
  status             ClaimStatus @default(pending)
  // Official claim number, set by the admin after manually filing the claim in
  // Triunfo's web (their API has no claims endpoint yet).
  insurerClaimNumber String?
  attachments        Json? // array of { filename, originalName, url, mimeType, size }
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt
  deletedAt          DateTime?

  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id])
  policyId       Int
  policy         Policy        @relation(fields: [policyId], references: [id])
  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  // Triunfo agent code that owns the underlying policy/client (for admin scoping).
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])

  @@index([producerCodeId])
}

// ─── NOVEDADES (centro de notificaciones del admin) ──────
// Generic notification feed for the admin panel. Each row is one actionable
// event the broker should see: a new claim (type "siniestro") or a customer
// asking for a human advisor (type "handoff"). title/body are denormalized at
// creation so the list needs no joins; the full detail is fetched from the
// source entity via `refId` when the admin opens it.
enum NotificationStatus {
  pending
  in_progress
  resolved
}

model Notification {
  category   String             @default("other") // baja | pagos | cotizacion | siniestro | documentos | other
  status     NotificationStatus @default(pending)
  resolvedAt DateTime?
  id         Int                @id @default(autoincrement())
  type       String // "siniestro" | "handoff" | "baja_poliza" | "lead" | "solicitud"
  refId      Int // Claim.id when type="siniestro"; Conversation.id for "handoff" and "baja_poliza"
  title      String
  body       String?            @db.Text
  readAt     DateTime? // null = unread; set when the admin marks it read
  createdAt  DateTime           @default(now())
  deletedAt  DateTime?

  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  // Triunfo agent code this novedad belongs to, so an admin only sees novedades
  // of the codes it can access. Nullable for handoffs not yet attributed to a code.
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])
  // Denormalized so the admin can filter/search novedades by client (DNI/name).
  // Nullable: a handoff from an unidentified WhatsApp number has no client yet.
  // Meta id of the WhatsApp number this came through (as Conversation.phoneNumberId):
  // the panel shows each branch only what came through its own number. Null = not
  // from a chat (web, panel) or older than this column; it counts as the
  // organization's default number's.
  phoneNumberId  String?

  clientId Int?
  client   Client? @relation(fields: [clientId], references: [id])

  @@index([producerId, status, category, createdAt])
  @@index([producerId, readAt])
  @@index([producerId, type, createdAt])
  @@index([clientId])
  @@index([producerCodeId])
  @@index([producerId, phoneNumberId])
}

// ─── COTIZACIONES ────────────────────────────────────────

model Quote {
  id              Int       @id @default(autoincrement())
  quoteNumber     Int       @unique
  vehicleType     String    @default("AUTO") // AUTO | MOTO
  brandCode       String
  modelCode       String
  manufactureYear Int
  postalCode      Int
  result          Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  // Triunfo agent code credited with this quote (defaults to the quoting user's code).
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])
  userId         Int?
  user           User?         @relation(fields: [userId], references: [id])
  quoteRequest   QuoteRequest?
  // Meta id of the WhatsApp number this came through (as Conversation.phoneNumberId):
  // the panel shows each branch only what came through its own number. Null = not
  // from a chat (web, panel) or older than this column; it counts as the
  // organization's default number's.
  phoneNumberId  String?

  @@index([producerCodeId])
  @@index([producerId, phoneNumberId])
}

// ─── SOLICITUDES DE COBERTURA (LEADS) ────────────────────

// Follow-up of a quote request or a contact lead in the admin panel.
enum LeadStatus {
  NEW
  CONTACTED
  CLOSED
}

model QuoteRequest {
  id      Int   @id @default(autoincrement())
  quoteId Int   @unique
  quote   Quote @relation(fields: [quoteId], references: [id])

  selectedCoverage  String
  coverageStartDate DateTime

  applicantType      String // FISICA | JURIDICA
  applicantFirstName String // razón social when applicantType is JURIDICA
  applicantLastName  String?
  applicantEmail     String
  applicantPhone     String
  applicantBirthDate DateTime?
  applicantDocType   String // DNI | CUIL | CUIT | PASAPORTE
  applicantDocNumber String
  applicantAddress   String

  // Preferred method only (CREDIT | DEBIT | OTHER). Card data is never stored:
  // an agent finalizes the payment when issuing the policy.
  paymentMethod String

  // Follow-up state for the unified "Solicitudes de cotización" admin panel,
  // shared with ContactLead so both lead kinds are managed the same way.
  status LeadStatus @default(NEW)
  notes  String?    @db.Text

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?
}

// ─── LEADS DE COTIZACIÓN (productos sin cotización online) ─
// Advisor-contact leads for the non-instant products. The `lead` products
// (bici, comercio, praxis, personas) come straight from a contact form; the
// `fixed` products (bolso, hogar) carry the chosen ProductPlan in selectedPlanId.
model ContactLead {
  id             Int        @id @default(autoincrement())
  productType    String // bici | comercio | praxis | personas | bolso | hogar
  channel        String // WEB | WHATSAPP
  status         LeadStatus @default(NEW)
  contactName    String
  phone          String
  email          String?
  payload        Json // product-specific fields (actividad, superficie, bici subtype, etc.)
  selectedPlanId Int? // set only for the fixed-price products (bolso, hogar)
  notes          String?    @db.Text
  conversationId Int? // set when the lead came from the WhatsApp bot
  // Meta id of the WhatsApp number this came through (as Conversation.phoneNumberId):
  // the panel shows each branch only what came through its own number. Null = not
  // from a chat (web, panel) or older than this column; it counts as the
  // organization's default number's.
  phoneNumberId  String?

  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  // Triunfo agent code credited with this lead (for admin scoping). Nullable.
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])
  selectedPlan   ProductPlan?  @relation(fields: [selectedPlanId], references: [id])

  @@index([producerId, status, createdAt])
  @@index([producerCodeId])
  @@index([producerId, phoneNumberId])
}

// ─── PLANES DE PRECIO FIJO (configurables por el admin) ───
// Admin-managed fixed-price plans for the products whose premium is a flat,
// pre-agreed monthly amount (bolso, hogar). The admin can create as many as
// needed per product type.
model ProductPlan {
  id            Int       @id @default(autoincrement())
  productType   String // bolso | hogar
  name          String // "Básico", "Plus", ...
  monthlyPrice  Decimal   @db.Decimal(12, 2)
  description   String?
  coverageItems Json // string[] of included coverages
  isActive      Boolean   @default(true)
  sortOrder     Int       @default(0)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  deletedAt     DateTime?

  producerId Int
  producer   Producer      @relation(fields: [producerId], references: [id])
  leads      ContactLead[]

  @@index([producerId, productType, isActive])
}

// ─── CONVERSACIONES WHATSAPP ─────────────────────────────

enum ConversationStatus {
  open
  pending
  closed
}

model Conversation {
  id        Int       @id @default(autoincrement())
  waId      String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  deletedAt DateTime?

  // Start of the current chat session. Messages older than this stay in the DB
  // (until the retention job prunes them) but are excluded from the context
  // window, so an idle user that comes back after the inactivity window starts
  // from scratch. Bumped on timeout and by the /reset dev command.
  sessionStartedAt DateTime?
  // Denormalized timestamp of the last message, kept for the inactivity sweep
  // so it doesn't have to join Message. Null = no activity to warn/expire.
  lastMessageAt    DateTime?
  // Set when the proactive inactivity warning was pushed for the current idle
  // period; cleared on new activity. Prevents re-warning the same silence.
  warnedAt         DateTime?
  // Number of inbound customer messages not yet opened in the web inbox.
  unreadCount      Int       @default(0)
  lastReadAt       DateTime?
  // Meta phone_number_id this chat came through. Stored so a proactive warning
  // is sent FROM the same number the user wrote to (a producer may own several).
  phoneNumberId    String?
  // Serialized deterministic flow state owned by the bot (JSON: { step, data }).
  // Persisted so the bot is stateless and resumes the exact step after a restart
  // or deploy instead of greeting from scratch. Cleared when a new session starts.
  flowState        String?   @db.Text

  // ─── Human handoff ───────────────────────────────────────
  // open: bot active · pending: waiting for an agent · closed
  status           ConversationStatus @default(open)
  // When true the bot skips the LLM/flow loop and only stores inbound messages.
  botPaused        Boolean            @default(false)
  assignedToUserId Int?
  assignedTo       User?              @relation("assigned_conversations", fields: [assignedToUserId], references: [id])
  handedOverAt     DateTime?

  producerId          Int
  producer            Producer             @relation(fields: [producerId], references: [id])
  // Triunfo agent code this chat resolves to. Set when the client identifies
  // (DNI/patente) — a number shared by several codes routes to the right code by
  // identification, not by the number. Drives inbox scoping for admins.
  producerCodeId      Int?
  producerCode        ProducerCode?        @relation(fields: [producerCodeId], references: [id])
  clientId            Int? // se vincula cuando el cliente se identifica por DNI
  client              Client?              @relation(fields: [clientId], references: [id])
  // When the current client link was made. A chat can be about someone else's
  // policy (a relative writes with the holder's DNI): unless the client's phone
  // is this WhatsApp number, the link only lasts for the session it was made in.
  clientLinkedAt      DateTime?
  // WhatsApp profile name of whoever writes from this number (Meta `contacts`).
  // The inbox shows it instead of the linked client when they are not the same person.
  contactName         String?              @db.VarChar(191)
  // Name an advisor set by hand in the inbox. Wins over the address book and
  // the WhatsApp profile name, which the bot refreshes on every message.
  contactNameManual   String?              @db.VarChar(191)
  messages            Message[]
  paymentRejections   PaymentRejection[]
  policyExpiryNotices PolicyExpiryNotice[]

  @@unique([waId, producerId])
  @@index([producerCodeId])
  @@index([producerId, lastMessageAt])
}

model Message {
  id          Int       @id @default(autoincrement())
  role        String // "user" | "assistant"
  content     String    @db.Text
  // Meta webhook id. Nullable for legacy/manual messages; unique when present so
  // webhook retries cannot duplicate an echo in the transcript.
  waMessageId String?   @unique @db.VarChar(191)
  // "live" (normal bot traffic), "app_echo" (sent from WhatsApp Business) or
  // "history" (one-time Coexistence backfill). Historical payloads never enter
  // the active bot session, but remain available for audit/import purposes.
  source      String    @default("live") @db.VarChar(20)
  // Preserves media metadata and any fields Meta adds without forcing a schema
  // migration for every WhatsApp message type.
  rawData     Json?
  createdAt   DateTime  @default(now())
  deletedAt   DateTime?

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])

  // History is fetched as `where conversationId order by createdAt desc take 10`
  // on every inbound message, and the retention job prunes by createdAt.
  @@index([conversationId, createdAt])
  @@index([source, createdAt])
}

// Contacts mirrored from the WhatsApp Business app through
// `smb_app_state_sync`. They are scoped to the Meta business phone number: the
// same customer can be saved under different names by different organizations.
model WhatsAppContact {
  id              Int       @id @default(autoincrement())
  phone           String    @db.VarChar(32)
  waId            String?   @db.VarChar(32)
  fullName        String?   @db.VarChar(191)
  firstName       String?   @db.VarChar(120)
  lastAction      String?   @db.VarChar(20)
  sourceUpdatedAt DateTime?
  rawData         Json?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  phoneNumberId Int
  phoneNumber   PhoneNumber @relation(fields: [phoneNumberId], references: [id])

  @@unique([phoneNumberId, phone])
  @@index([phoneNumberId, deletedAt])
}

// ─── INTEGRATION TOKENS ──────────────────────────────────
// Persisted third-party auth tokens (currently Triunfo's JWT).
//
// Triunfo issues a JWT valid ~24 h and returns the SAME token while it is still
// valid ("Token aún no vencido"). Caching it only in memory meant every API
// restart — and every extra instance — hit `getTokenRest` again. Triunfo warned
// that hammering that endpoint can get the IP blocked, so the token is stored
// here and shared across restarts and instances.
//
// `key` identifies the credential set, e.g. "triunfo:10484:JHONPELL".
// One row per WhatsApp Business Account connected through Embedded Signup.
// Each organization brings its OWN WABA and its own business token: the token is
// customer-scoped, so it belongs in the database and not in the environment.
model WabaAccount {
  id               Int       @id @default(autoincrement())
  wabaId           String    @unique @db.VarChar(64)
  producerId       Int
  producer         Producer  @relation(fields: [producerId], references: [id])
  // Business token from the Embedded Signup code exchange, encrypted at rest with
  // WABA_TOKEN_ENCRYPTION_KEY (AES-256-GCM). Never log it, never return it from an
  // endpoint other than the bot context call.
  accessToken      String    @db.Text
  // Cuándo vence el business token. La plantilla estándar de Embedded Signup
  // emite tokens de 60 DÍAS: si nadie lo renueva, el número deja de responder
  // de un día para el otro y sin aviso. Null = la respuesta de Meta no informó
  // vencimiento (token de larga duración).
  tokenExpiresAt   DateTime?
  // True when onboarded through Coexistence — the business keeps using the
  // WhatsApp Business app on the same number.
  isCoexistence    Boolean   @default(false)
  // Stamped when Meta reports account_update -> PARTNER_REMOVED. Non-null means
  // the number stopped delivering webhooks (usually: nobody opened the app in 13 days).
  disconnectedAt   DateTime?
  disconnectReason String?   @db.VarChar(64)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  phoneNumbers PhoneNumber[]

  @@index([producerId])
}

// Triunfo web-service credentials of one organization: every quote, cartera
// sync and document request of that org goes out with them. The org named by
// DEFAULT_PRODUCER_SLUG may have none and use TRIUNFO_PRODUCTOR/USUARIO/PASSWORD.
model TriunfoCredential {
  id         Int       @id @default(autoincrement())
  producerId Int       @unique
  producer   Producer  @relation(fields: [producerId], references: [id])
  // "Codigo" of getTokenRest; the JWT it returns is tied to this code.
  productor  String    @db.VarChar(20)
  username   String    @db.VarChar(100)
  // Encrypted at rest with WABA_TOKEN_ENCRYPTION_KEY (AES-256-GCM). Never log it
  // and never return it from an endpoint.
  password   String    @db.Text
  // When Triunfo accepted them: they are only saved after getTokenRest says yes.
  verifiedAt DateTime
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?
}

model IntegrationToken {
  id        Int      @id @default(autoincrement())
  key       String   @unique @db.VarChar(191)
  token     String   @db.Text
  // Absolute expiry taken from the JWT `exp` claim (no safety margin applied here;
  // the service subtracts its own margin when deciding whether to reuse).
  expiresAt DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum TaskStatus {
  PENDING
  IN_PROGRESS
  DONE
}

/// Internal to-dos the office leaves each other, outside the bot: a call to
/// return, a document to send. Someone creates it for a person, who works it
/// and can reply in its comments.
model Task {
  id           Int        @id @default(autoincrement())
  title        String     @db.VarChar(200)
  description  String?    @db.Text
  status       TaskStatus @default(PENDING)
  // Day it should be done by (no time of day).
  dueDate      DateTime?  @db.Date
  // Who to call back, when the task comes from a phone call.
  contactName  String?    @db.VarChar(120)
  contactPhone String?    @db.VarChar(40)
  // When the assignee first saw it: before that the panel marks it as new.
  seenAt       DateTime?
  completedAt  DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  deletedAt    DateTime?

  producerId   Int
  producer     Producer      @relation(fields: [producerId], references: [id])
  createdById  Int
  createdBy    User          @relation("tasks_created", fields: [createdById], references: [id])
  assignedToId Int
  assignedTo   User          @relation("tasks_assigned", fields: [assignedToId], references: [id])
  comments     TaskComment[]

  @@index([producerId, assignedToId, status])
  @@index([producerId, createdById, status])
}

model TaskComment {
  id        Int       @id @default(autoincrement())
  body      String    @db.Text
  createdAt DateTime  @default(now())
  deletedAt DateTime?

  taskId Int
  task   Task @relation(fields: [taskId], references: [id])
  userId Int
  user   User @relation(fields: [userId], references: [id])

  @@index([taskId, createdAt])
}

// ─── RECHAZOS DE PAGO ────────────────────────────────────

/// Debit vs card, read from the entity Triunfo reports ("NACION ARGENTINA" vs
/// "VISA DEBITO"): Triunfo sends one Excel for each.
enum PaymentRejectionChannel {
  ACCOUNT
  CARD
}

enum PaymentRejectionStatus {
  // Can be sent: the client still owes the installment and was not told yet.
  READY
  // Left out of the send by default (see skipReason); the office may still pick it.
  SKIPPED
  // Handed to the bot, waiting for Meta.
  SENDING
  SENT
  FAILED
  // The office told the client by other means (the CBU Excel of 20/10 went out by hand).
  MARKED
}

/// One Excel of Triunfo's "Planilla de rechazos por débito automático" the office
/// loaded in "Rechazos". The file itself is read in the browser; only its rows land here.
model PaymentRejectionImport {
  id          Int       @id @default(autoincrement())
  fileName    String    @db.VarChar(255)
  // "Desde: 05/10/2026 Hasta: 20/10/2026", as the Excel's title says it.
  periodLabel String?   @db.VarChar(120)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  producerId  Int
  producer    Producer           @relation(fields: [producerId], references: [id])
  createdById Int
  createdBy   User               @relation(fields: [createdById], references: [id])
  rejections  PaymentRejection[]

  @@index([producerId, createdAt])
}

/// A rejected installment from an imported Excel, and the WhatsApp notice about it.
model PaymentRejection {
  id                Int                     @id @default(autoincrement())
  // Row of the Excel (1-based, as Excel numbers it), to find it in the file.
  rowNumber         Int
  holderName        String                  @db.VarChar(160)
  // Triunfo's "Art." (product line, 465 = autos).
  branch            Int?
  certificateNumber String                  @db.VarChar(20)
  endorsementNumber Int?
  installmentNumber Int
  dueDate           DateTime                @db.Date
  amount            Decimal                 @db.Decimal(12, 2)
  entity            String                  @db.VarChar(80)
  channel           PaymentRejectionChannel
  // Only the last digits of the CBU or card: enough for the office to tell them apart.
  accountLast4      String?                 @db.VarChar(4)
  reason            String                  @db.VarChar(120)
  // "¿Cuota aún pendiente?": NO means it was paid after the rejection.
  stillPending      Boolean
  // The number as the Excel has it (mobile, else home) and the WhatsApp id it maps to.
  phone             String?                 @db.VarChar(40)
  waId              String?                 @db.VarChar(20)
  status            PaymentRejectionStatus  @default(READY)
  // NO_PHONE | ALREADY_PAID | ALREADY_NOTIFIED, when status is SKIPPED.
  skipReason        String?                 @db.VarChar(40)
  // Why WhatsApp did not take the notice, in the office's words.
  error             String?                 @db.VarChar(500)
  sentAt            DateTime?
  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt
  deletedAt         DateTime?

  importId       Int
  import         PaymentRejectionImport @relation(fields: [importId], references: [id])
  producerId     Int
  producer       Producer               @relation(fields: [producerId], references: [id])
  producerCodeId Int?
  producerCode   ProducerCode?          @relation(fields: [producerCodeId], references: [id])
  policyId       Int?
  policy         Policy?                @relation(fields: [policyId], references: [id])
  clientId       Int?
  client         Client?                @relation(fields: [clientId], references: [id])
  // The chat the notice went to, so the panel can open it.
  conversationId Int?
  conversation   Conversation?          @relation(fields: [conversationId], references: [id])
  sentById       Int?
  sentBy         User?                  @relation(fields: [sentById], references: [id])

  @@index([importId, rowNumber])
  // Finds an earlier notice for the same installment (the Excels overlap in time).
  @@index([producerId, certificateNumber, installmentNumber])
}

enum PolicyExpiryNoticeStatus {
  SENDING
  SENT
  FAILED
  MARKED
}

// A WhatsApp notice that a policy ran out, sent from the cobranzas "pólizas
// vencidas" worklist with the Meta template POLICY_EXPIRY_TEMPLATE, or MARKED
// when the office told the client by other means. One row per attempt.
model PolicyExpiryNotice {
  id        Int                      @id @default(autoincrement())
  status    PolicyExpiryNoticeStatus @default(SENDING)
  phone     String?                  @db.VarChar(40)
  waId      String?                  @db.VarChar(20)
  error     String?                  @db.VarChar(500)
  sentAt    DateTime?
  createdAt DateTime                 @default(now())
  updatedAt DateTime                 @updatedAt
  deletedAt DateTime?

  producerId     Int
  producer       Producer      @relation(fields: [producerId], references: [id])
  producerCodeId Int?
  producerCode   ProducerCode? @relation(fields: [producerCodeId], references: [id])
  policyId       Int
  policy         Policy        @relation(fields: [policyId], references: [id])
  clientId       Int
  client         Client        @relation(fields: [clientId], references: [id])
  conversationId Int?
  conversation   Conversation? @relation(fields: [conversationId], references: [id])
  sentById       Int?
  sentBy         User?         @relation("policy_expiry_notices_sent", fields: [sentById], references: [id])

  @@index([policyId, createdAt])
  @@index([producerId, status])
}
