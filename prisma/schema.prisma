// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "mysql"
}

// ─── PRODUCTOR (tenant) ──────────────────────────────────

model Producer {
  id            Int            @id @default(autoincrement())
  name          String
  slug          String         @unique
  systemPrompt  String         @db.Text
  isActive      Boolean        @default(true)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?

  phoneNumbers  PhoneNumber[]
  users         User[]
  clients       Client[]
  cotizaciones  Cotizacion[]
  conversations Conversation[]
}

model PhoneNumber {
  id            Int       @id @default(autoincrement())
  phoneNumberId String    @unique   // ID de Meta
  number        String              // display: "+1 555 151 7253"
  isActive      Boolean   @default(true)
  deletedAt     DateTime?
  producerId    Int
  producer      Producer  @relation(fields: [producerId], references: [id])
}

// ─── EMPLEADOS / ADMINS DE JOHN ──────────────────────────

model User {
  id           Int          @id @default(autoincrement())
  email        String       @unique
  password     String
  role         String       @default("admin")  // "admin" | "empleado"
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  deletedAt    DateTime?

  producerId   Int
  producer     Producer     @relation(fields: [producerId], references: [id])
  cotizaciones Cotizacion[]
}

// ─── CLIENTES ASEGURADOS ─────────────────────────────────

model Client {
  id                     Int       @id @default(autoincrement())
  dni                    String
  firstName              String
  lastName               String
  email                  String
  password               String
  requiresPasswordChange Boolean   @default(true)
  phone                  String?
  city                   String?
  createdAt              DateTime  @default(now())
  updatedAt              DateTime  @updatedAt
  deletedAt              DateTime?

  producerId    Int
  producer      Producer       @relation(fields: [producerId], references: [id])
  conversations Conversation[]

  @@unique([email, producerId])
  @@unique([dni, producerId])
  @@unique([phone, producerId])
}

// ─── COTIZACIONES ────────────────────────────────────────

model Cotizacion {
  id              Int       @id @default(autoincrement())
  quoteNumber     Int       @unique
  brandCode       String
  modelCode       String
  manufactureYear Int
  postalCode      Int
  result          Json
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  producerId      Int
  producer        Producer  @relation(fields: [producerId], references: [id])
  userId          Int?
  user            User?     @relation(fields: [userId], references: [id])
}

// ─── CONVERSACIONES WHATSAPP ─────────────────────────────

model Conversation {
  id         Int       @id @default(autoincrement())
  waId       String
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  deletedAt  DateTime?

  producerId Int
  producer   Producer  @relation(fields: [producerId], references: [id])
  clientId   Int?      // se vincula cuando el cliente se identifica por DNI
  client     Client?   @relation(fields: [clientId], references: [id])
  messages   Message[]

  @@unique([waId, producerId])
}

model Message {
  id             Int          @id @default(autoincrement())
  role           String       // "user" | "assistant"
  content        String       @db.Text
  createdAt      DateTime     @default(now())
  deletedAt      DateTime?

  conversationId Int
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}